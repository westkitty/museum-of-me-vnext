    { "id": "round-trip-dom-growth", "path": "transitions[*].domGrowth", "max": 20, "unit": "nodes", "why": "after GC across 10 round trips" },
    { "id": "round-trip-heap-growth", "path": "transitions[*].heapGrowthMB", "max": 5, "unit": "MB", "why": "after GC across 10 round trips" }
  ]
