    { "id": "exterior-walk-p99", "path": "exteriorWalkingPath1.frames.p99", "max": 20, "unit": "ms" },
    { "id": "exterior-walk-fps", "path": "exteriorWalkingPath1.frames.fps", "min": 55, "unit": "fps" },
    { "id": "interior-steady-p95", "path": "interiorSteady.frames.p95", "max": 20, "unit": "ms" },
    { "id": "exterior-after-return-p99", "path": "exteriorAfterReturn.first5s.p99", "max": 20, "unit": "ms" },
    { "id": "workshop-2000-p99", "path": "workshop2000.after.frames.p99", "max": 20, "unit": "ms" },
    { "id": "workshop-2000-sweep-p99", "path": "workshop2000.residencySweep.frames.p99", "max": 20, "unit": "ms" },
