# Cloudflare Pages / Netlify header rules.
#
# The museum currently ships no runtime binary assets — its present models,
# textures and ambience are procedural — so long-lived caching applies to the
# hashed build output while the HTML shell always revalidates.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  X-Frame-Options: DENY
  # The museum makes no outbound runtime requests of its own. The one governed
  # exception is a YouTube screening the visitor explicitly chooses and accepts
  # in the cinema (docs/MUSEUM_CINEMA_YOUTUBE_2026-11-21.md): YouTube's official
  # IFrame Player API script, its privacy-enhanced player frame, and video
  # thumbnails shown after that acceptance. Keep this synchronized.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.youtube.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://i.ytimg.com; media-src 'self' blob:; connect-src 'self'; font-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/index.html
  Cache-Control: public, max-age=0, must-revalidate
