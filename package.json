{
  "name": "museum-of-me-vnext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Museum of Me — The Reliquary of Iterative Becoming vNext. A persistent first-person Three.js museum.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:release-tools": "node --test scripts/hosted-verifier.test.mjs scripts/human-evidence-verifier.test.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:mapping": "node scripts/validate-mapping.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:privacy": "node scripts/validate-privacy.mjs",
    "check:budgets": "node scripts/check-budgets.mjs",
    "verify:dist": "node scripts/verify-release-dist.mjs",
    "verify:hosted": "node scripts/verify-hosted.mjs",
    "verify:human-evidence": "node scripts/verify-human-evidence.mjs",
    "gate": "npm run typecheck && npm run lint && npm test && npm run test:release-tools && npm run validate:mapping && npm run validate:content && npm run validate:privacy && npm run validate:frameloop && npm run validate:hotpaths && npm run validate:assets && npm run validate:exhibits && npm run qa && npm run build && npm run check:budgets && npm run verify:dist",
    "validate:frameloop": "node scripts/validate-frameloop.mjs",
    "validate:hotpaths": "node scripts/validate-hotpaths.mjs",
    "build:collection": "node scripts/build-collection.mjs",
    "validate:exhibits": "node scripts/validate-exhibits.mjs",
    "qa": "node scripts/qa-report-runner.mjs"
  },
  "dependencies": {
    "three": "0.185.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/three": "0.185.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
